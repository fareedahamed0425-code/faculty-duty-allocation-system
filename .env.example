# ==========================================
# Frontend Configuration (Vercel / Local)
# ==========================================
# In production on Vercel, set VITE_API_URL to your deployed Render URL + /api/v1
# Example: https://faculty-duty-allocation-system.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Firebase Authentication Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ==========================================
# Backend Configuration (Render / Local)
# ==========================================
# NVIDIA API Credentials
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_INVOKE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Institutional Configuration
SECRET_KEY=institution_scheduling_secret_jwt_key_2026_production_grade
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_WEEKLY_SUBSTITUTIONS=4
MAX_DAILY_REGULAR_CLASSES=2
WEEK_START_DAY=0
WEEK_END_DAY=6
INSTITUTION_NAME=The Apollo University
TIMEZONE=Asia/Kolkata

# Database (SQLite default for local/Render disk, or PostgreSQL URL)
DATABASE_URL=sqlite:///./faculty_scheduler.db
